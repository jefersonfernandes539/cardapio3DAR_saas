# ---- Database ----------------------------------------------------------
# Used by packages/db (Prisma) and both apps.
# Local dev (Docker Postgres, no pooler): both point at the same database.
DATABASE_URL="postgresql://cardapio:cardapio@localhost:5434/cardapio_ar?schema=public"
DIRECT_URL="postgresql://cardapio:cardapio@localhost:5434/cardapio_ar?schema=public"
#
# --- Supabase Postgres (production) ---
# Project Settings > Database > Connection string. Two different strings,
# both required (see packages/db/prisma/schema.prisma for why):
# DATABASE_URL  = "Transaction" mode, port 6543 — used by the running app.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL    = "Session" mode, port 5432 — used only by `prisma migrate`.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Auth.js / NextAuth (apps/admin) -----------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3001"

# ---- Storage (apps/admin uploads) ---------------------------------------
# "local" (default, dev): browser posts the file to apps/admin, which writes
# it to apps/admin/public/uploads.
# "s3": apps/admin hands the browser a presigned URL and the file goes
# straight to an S3-compatible bucket (see apps/admin/src/lib/{storage,s3}.ts)
# — no file bytes ever touch this server. Works with Cloudflare R2, Supabase
# Storage, AWS S3, Backblaze B2, etc.; only the values below change.
STORAGE_DRIVER="local"

# Required when STORAGE_DRIVER=s3.
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION defaults to "auto" (correct for Cloudflare R2, which ignores
# region). Other providers validate it as part of the request signature —
# set it to the bucket's actual region there (e.g. Supabase: the project's
# region, visible on the same screen as its S3 credentials).
# S3_REGION="auto"
# Public URL the bucket is served from — apps/menu also reads this (see
# apps/menu/next.config.js) to allow next/image to optimize images served
# from it.
# S3_PUBLIC_BASE_URL=""
#
# --- Cloudflare R2 ---
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com" (R2 dashboard
#   > bucket > Settings)
# S3_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev" (enable "Public access"
#   on the bucket first)
# Credentials: R2 > Manage API tokens > Create API token, scoped to the
#   bucket, "Object Read & Write" permission.
# CORS is NOT automatic on R2 — without it, the browser blocks the PUT to
#   the presigned URL before it reaches R2. Bucket > Settings > CORS Policy:
#     AllowedOrigins: ["http://localhost:3001", "https://admin.seudominio.com"]
#     AllowedMethods: ["PUT"]
#     AllowedHeaders: ["Content-Type"]
# R2 has zero egress fees, which matters once AR traffic is real (see
# README's "Storage: upload direto para bucket" section) — the natural next
# step after starting on a free-tier alternative below.
#
# --- Supabase Storage (no credit card required on the free tier) ---
# S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
# S3_REGION="<project's region>" (Project Settings > Storage > S3 Connection
#   — must match exactly, unlike R2's "auto")
# S3_PUBLIC_BASE_URL="https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>"
#   (bucket must be created as Public)
# Credentials: Project Settings > Storage > S3 Connection > "New access key".
# No CORS setup needed — Supabase Storage's S3 endpoint allows all origins
# by default.
# Free tier: 1GB storage + 5GB egress/month, enough for an early launch;
# revisit R2 once traffic outgrows that.

# ---- Public app URLs ------------------------------------------------------
NEXT_PUBLIC_MENU_URL="http://localhost:3000"
# Where apps/menu reaches apps/admin *server-to-server* to proxy the
# "/uploads/*" rewrite (see apps/menu/next.config.js) that serves locally
# uploaded dish photos/models through apps/menu's own origin. Only needs to
# change if apps/admin isn't reachable at localhost:3001 from wherever
# apps/menu's server runs (e.g. separate containers).
ADMIN_INTERNAL_URL="http://localhost:3001"
