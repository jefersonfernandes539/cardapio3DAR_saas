{
  "name": "cardapio-ar-saas",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18.17.0"
  },
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "postinstall": "pnpm --filter @cardapio/db run generate",
    "dev": "dotenv -e .env -- turbo run dev",
    "dev:menu": "dotenv -e .env -- turbo run dev --filter=@cardapio/menu",
    "dev:admin": "dotenv -e .env -- turbo run dev --filter=@cardapio/admin",
    "build": "dotenv -e .env -- turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @cardapio/db run generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @cardapio/db run migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @cardapio/db run seed",
    "db:studio": "dotenv -e .env -- pnpm --filter @cardapio/db run studio"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  }
}
